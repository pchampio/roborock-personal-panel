# A working local_roborock_server, reachable FROM the panel container.
RR_BASE_URL=http://host.docker.internal:555
RR_EMAIL=you@example.com
# Your local server's protocol login code; not the camera unlock pattern.
RR_PIN=replace-me
# Optional: override the MQTT endpoint advertised by your local server.
# RR_MQTT_URL=mqtt://@your-internal-broker:1883
# Set to 1 only if the panel cannot directly reach the robot on its LAN.
RR_NO_LOCAL=0
# Optional camera unlock pattern; normally enter it in the web UI instead.
RR_CAMERA_PIN=
# Optional additional browser ICE servers as a JSON array.
RR_CAMERA_TURNS=
RR_REGION=eu
# Loopback only. Use an authenticated HTTPS reverse proxy for remote access.
BIND_ADDR=127.0.0.1
HOST_PORT=8099

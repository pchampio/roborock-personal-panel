+# --- water level slider -------------------------------------------------
+# Models with the pure-water-flow slider (confirmed on the Saros 10R,
+# roborock.vacuum.a144) do not pick from an enum: they send a level on a
+# 1..30 scale, encoded as WATER_LEVEL_BASE + level. The device UI groups
+# those levels into named bands.
+#
+# The band table comes from the Saros 10R app. It is corroborated by the
+# codes already in WATER_SLIDE_MODE_MAPPING for slight (221 -> 1), low
+# (225 -> 5), medium (235 -> 15) and extreme (250 -> 30); it also shows that
+# "gentle" and "moderate" had no entry at all, and that 245/248 were labelled
+# one band low (they are high/extreme, not moderate/high).
+WATER_LEVEL_BASE = 220
+WATER_LEVEL_MIN = 1
+WATER_LEVEL_MAX = 30
+# Bands carry their own name rather than borrowing the enum's string: the
+# existing members for 245 and 248 are labelled one band low ("moderate" and
+# "high" where the device means high and extreme), and they cannot simply be
+# renamed because a duplicate value would alias 248 onto EXTREME's code (208).
+WATER_LEVEL_BANDS: tuple[tuple[int, int, str], ...] = (
+    (1, 3, "slight"),
+    (4, 7, "low"),
+    (8, 12, "gentle"),
+    (13, 17, "medium"),
+    (18, 22, "moderate"),
+    (23, 27, "high"),
+    (28, 30, "extreme"),
+)
+
+
+def water_level_to_code(level: int) -> int:
+    """1..30 slider level -> the water_box_mode code to send."""
+    level = max(WATER_LEVEL_MIN, min(WATER_LEVEL_MAX, int(level)))
+    return WATER_LEVEL_BASE + level
+
+
+def water_code_to_level(code: int) -> int | None:
+    """water_box_mode code -> slider level, or None if it is not a slider code."""
+    level = int(code) - WATER_LEVEL_BASE
+    return level if WATER_LEVEL_MIN <= level <= WATER_LEVEL_MAX else None
+
+
+def water_level_band(level: int) -> str:
+    """The name of the band a slider level falls in ("gentle", "medium", ...)."""
+    for lo, hi, name in WATER_LEVEL_BANDS:
+        if lo <= level <= hi:
+            return name
+    return "off"

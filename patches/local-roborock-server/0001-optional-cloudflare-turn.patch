--- /dev/null
+++ b/src/roborock_local_server/bundled_backend/shared/cloudflare_turn.py
@@ -0,0 +1,94 @@
+"""Short-lived TURN credentials from Cloudflare Realtime (TURN service).
+
+Cloudflare's relay takes no static login: each set of credentials is minted by
+its API for a TTL, from a TURN key (id + API token) created in the dashboard.
+The robot asks for its relay through /fwapi/createca on every preview start, so
+credentials are cached and only re-minted once most of the TTL has gone -- the
+API is never in the path of more than the first request of a while.
+
+The point of using it: both the robot and the viewer connect OUT to the relay,
+so nothing has to be reachable from the internet on this side at all.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import threading
+import time
+import urllib.request
+from typing import Any
+from urllib.parse import urlsplit
+
+LOG = logging.getLogger(__name__)
+
+API_URL = "https://rtc.live.cloudflare.com/v1/turn/keys/{key_id}/credentials/generate-ice-servers"
+TIMEOUT_SECONDS = 8
+# Re-mint once this fraction of the TTL has passed, so a robot that fetched near
+# the end of a cache window still holds credentials valid for a whole session.
+REFRESH_FRACTION = 0.5
+
+_lock = threading.Lock()
+_cache: dict[str, Any] = {"key": None, "at": 0.0, "ttl": 0, "servers": None}
+
+
+def _fetch(key_id: str, api_token: str, ttl: int) -> dict[str, Any]:
+    request = urllib.request.Request(
+        API_URL.format(key_id=key_id),
+        data=json.dumps({"ttl": ttl}).encode(),
+        # Cloudflare's edge answers 403 to urllib's default "Python-urllib/x.y".
+        headers={"Authorization": f"Bearer {api_token}", "Content-Type": "application/json",
+                 "User-Agent": "roborock-local-server"},
+        method="POST",
+    )
+    with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
+        payload = json.loads(response.read(65536))
+    servers = payload.get("iceServers") if isinstance(payload, dict) else None
+    # The API has answered both as one object and as a list of them.
+    if isinstance(servers, dict):
+        servers = [servers]
+    if not isinstance(servers, list) or not servers:
+        raise ValueError("Cloudflare TURN answered without iceServers")
+    urls: list[str] = []
+    username = credential = ""
+    for server in servers:
+        if not isinstance(server, dict):
+            continue
+        entry = server.get("urls")
+        urls += [entry] if isinstance(entry, str) else [u for u in (entry or []) if isinstance(u, str)]
+        if server.get("username") and not username:
+            username, credential = str(server["username"]), str(server.get("credential") or "")
+    if not username:
+        raise ValueError("Cloudflare TURN answered without credentials")
+    return {"urls": urls, "username": username, "credential": credential}
+
+
+def ice_servers(key_id: str, api_token: str, ttl: int) -> dict[str, Any]:
+    """{urls, username, credential}, cached for REFRESH_FRACTION of the TTL."""
+    cache_key = (key_id, api_token, ttl)
+    with _lock:
+        fresh = (_cache["key"] == cache_key and _cache["servers"] is not None
+                 and time.time() - _cache["at"] < _cache["ttl"] * REFRESH_FRACTION)
+        if fresh:
+            return _cache["servers"]
+        servers = _fetch(key_id, api_token, ttl)
+        _cache.update(key=cache_key, at=time.time(), ttl=ttl, servers=servers)
+        LOG.info("Cloudflare TURN credentials minted (ttl %ss, %d urls)", ttl, len(servers["urls"]))
+        return servers
+
+
+def robot_url(urls: list[str]) -> str:
+    """The one address the robot gets: plain UDP TURN on a standard port.
+
+    The only form proven with this firmware is upstream's `turn:host:port` -- a
+    Saros 10R handed turns: gathered no relay at all -- so the query string is
+    dropped and port 53 (offered by Cloudflare for restrictive networks) avoided.
+    """
+    plain = [u for u in urls if u.startswith("turn:")]
+    udp = [u for u in plain if "transport=tcp" not in u]
+    for url in udp + plain:
+        base = url.split("?", 1)[0]
+        port = urlsplit("//" + base.split(":", 1)[1]).port
+        if port != 53:
+            return base
+    raise ValueError("Cloudflare TURN offered no turn: url")

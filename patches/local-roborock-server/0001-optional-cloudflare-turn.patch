diff --git a/tests/test_cloudflare_turn.py b/tests/test_cloudflare_turn.py
new file mode 100644
index 0000000..4cbac93
--- /dev/null
+++ b/tests/test_cloudflare_turn.py
@@ -0,0 +1,97 @@
+"""``turn.mode = "cloudflare"``: createca hands out credentials minted by Cloudflare."""
+
+from __future__ import annotations
+
+import dataclasses
+
+import pytest
+
+import roborock_local_server.backend as backend  # noqa: F401 -- puts bundled_backend on sys.path
+from shared import cloudflare_turn  # noqa: E402
+
+from test_fw_createca import _make_context, _resolve
+
+CF_URLS = [
+    "stun:stun.cloudflare.com:3478",
+    "stun:stun.cloudflare.com:53",
+    "turn:turn.cloudflare.com:3478?transport=udp",
+    "turn:turn.cloudflare.com:53?transport=udp",
+    "turn:turn.cloudflare.com:3478?transport=tcp",
+    "turns:turn.cloudflare.com:5349?transport=tcp",
+    "turns:turn.cloudflare.com:443?transport=tcp",
+]
+
+
+@pytest.fixture(autouse=True)
+def _clear_cache():
+    cloudflare_turn._cache.update(key=None, at=0.0, ttl=0, servers=None)
+    yield
+
+
+def _cf_context(tmp_path, *, key_id="kid", token="tok"):
+    ctx = _make_context(tmp_path, turn_enabled=True)
+    return dataclasses.replace(ctx, turn_mode="cloudflare", turn_cloudflare_key_id=key_id,
+                               turn_cloudflare_api_token=token)
+
+
+def test_robot_url_is_plain_udp_without_query_and_never_port_53():
+    assert cloudflare_turn.robot_url(CF_URLS) == "turn:turn.cloudflare.com:3478"
+    assert cloudflare_turn.robot_url(["turn:t.example:53?transport=udp",
+                                      "turn:t.example:3478?transport=tcp"]) == "turn:t.example:3478"
+
+
+def test_createca_serves_cloudflare_credentials_and_caches_them(tmp_path, monkeypatch):
+    calls = []
+
+    def fake_fetch(key_id, api_token, ttl):
+        calls.append((key_id, api_token, ttl))
+        return {"urls": CF_URLS, "username": "cf-user", "credential": "cf-pass"}
+
+    monkeypatch.setattr(cloudflare_turn, "_fetch", fake_fetch)
+    ctx = _cf_context(tmp_path)
+
+    route_name, payload = _resolve(ctx, "/iot.roborock.com/fwapi/createca")
+    _resolve(ctx, "/iot.roborock.com/fwapi/createca")
+
+    assert route_name == "fw_createca"
+    data = payload["data"]
+    assert data["url"] == "turn:turn.cloudflare.com:3478"
+    assert data["urls"] == ["turn:turn.cloudflare.com:3478", "stun:stun.cloudflare.com:3478"]
+    assert data["user"] == data["username"] == "cf-user"
+    assert data["pwd"] == data["credential"] == "cf-pass"
+    assert payload["result"] == data
+    assert calls == [("kid", "tok", 86400)]          # second request served from cache
+
+
+def test_createca_falls_back_to_catchall_without_key_or_on_api_failure(tmp_path, monkeypatch):
+    def failing_fetch(*_args):
+        raise OSError("unreachable")
+
+    monkeypatch.setattr(cloudflare_turn, "_fetch", failing_fetch)
+    for ctx in (_cf_context(tmp_path, key_id=""), _cf_context(tmp_path)):
+        _route, payload = _resolve(ctx, "/iot.roborock.com/fwapi/createca")
+        assert "url" not in (payload.get("data") or {})
+
+
+def test_fetch_accepts_list_and_object_shapes(monkeypatch):
+    class Resp:
+        def __init__(self, body):
+            self.body = body
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *a):
+            return False
+
+        def read(self, _n):
+            return self.body
+
+    import json
+    for shape in ({"urls": CF_URLS, "username": "u", "credential": "c"},
+                  [{"urls": CF_URLS[:2]}, {"urls": CF_URLS[2:], "username": "u", "credential": "c"}]):
+        monkeypatch.setattr(cloudflare_turn.urllib.request, "urlopen",
+                            lambda *_a, **_k: Resp(json.dumps({"iceServers": shape}).encode()))
+        got = cloudflare_turn._fetch("k", "t", 60)
+        assert got["username"] == "u" and got["credential"] == "c"
+        assert "turn:turn.cloudflare.com:3478?transport=udp" in got["urls"]
